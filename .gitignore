
# ==========================================
# Unity 3D - .gitignore
# ==========================================

# Carpetas generadas automáticamente por Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Archivos temporales y de caché
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~

# Archivos de IDEs (Visual Studio / Rider / VS Code)
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos generados por Unity
*.unityproj
*.slnx
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Crash Reports
sysinfo.txt

# Builds y paquetes exportados
*.apk
*.aab
*.unitypackage

# Addressables (datos generados)
 /Assets/AddressableAssetsData/*/*.bin*

# Asset Store Tools
/Assets/AssetStoreTools*

# Autogenerados por paquetes de Unity
/Assets/Plugins/Editor/JetBrains*
